// Inventory management schema.
// Purchases and sales share ONE table (Transaction.type) because they have
// identical shape — only the direction of goods differs.

// Prisma 7: datasource url lives in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  items        Item[]
  itemTypes    ItemType[]
  parties      Party[]
  transactions Transaction[]
  payments     Payment[]

  @@map("users")
}

// The user's own list of "types of goods" (Rice, Pulse, Oil, ...).
// Per user, not global: each shop builds its own list.
model ItemType {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items Item[]

  @@unique([userId, name])
  @@map("item_types")
}

// A kind of goods the user stocks, e.g. "Basmati Rice" of type "Rice".
model Item {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  typeId    String   @map("type_id")
  unit      String   @default("kg") // see UNITS in src/lib/pricing.ts
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type  ItemType          @relation(fields: [typeId], references: [id], onDelete: NoAction)
  lines TransactionLine[]

  @@unique([userId, name])
  @@index([typeId])
  @@map("items")
}

// Someone we buy from (SUPPLIER), sell to (CUSTOMER), or both.
model Party {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  phone     String?
  address   String?
  kind      String // see PARTY_KINDS in src/lib/domain.ts
  createdAt DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  payments     Payment[]

  @@index([userId, kind])
  @@map("parties")
}

// One purchase bill or one sale bill.
model Transaction {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  type        String // PURCHASE | SALE
  partyId     String    @map("party_id")
  date        DateTime  @db.Date
  note        String?
  // Denormalised sum of line totals, written once on create.
  totalAmount Float     @map("total_amount")
  // Set when the user marks a fully paid bill as settled; it then leaves the
  // payments screen. Null = still open.
  settledAt   DateTime? @map("settled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  party       Party               @relation(fields: [partyId], references: [id], onDelete: NoAction)
  lines       TransactionLine[]
  allocations PaymentAllocation[]

  @@index([userId, type, date])
  @@index([partyId])
  @@map("transactions")
}

model TransactionLine {
  id              String @id @default(cuid())
  transactionId   String @map("transaction_id")
  itemId          String @map("item_id")
  quantity        Float // count in `unit`, e.g. 50 (packets)
  unit            String // snapshot of Item.unit at the time of the bill
  // Weight of ONE unit, e.g. 25 (kg per packet). Null for items counted in kg,
  // and for lines saved before this column existed.
  weightPerUnitKg Float? @map("weight_per_unit_kg")
  weightKg        Float  @map("weight_kg") // total = quantity x weightPerUnitKg
  ratePerKg       Float  @map("rate_per_kg")
  totalCost       Float  @map("total_cost")
  // SALE lines only: the purchase price per kg of the stock lot sold from
  // ("miniket-40rs/kg"). Null on purchases and on sales saved before lots.
  lotRatePerKg    Float? @map("lot_rate_per_kg")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  item        Item        @relation(fields: [itemId], references: [id], onDelete: NoAction)

  @@index([transactionId])
  @@index([itemId])
  @@map("transaction_lines")
}

// Money handed over for bills, paid in parts over days.
// type = the bills it pays: SALE = received from a customer,
// PURCHASE = paid to a supplier (same vocabulary as Transaction.type).
model Payment {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String // PURCHASE | SALE
  partyId   String   @map("party_id")
  date      DateTime @db.Date
  amount    Float // = sum of allocations
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  party       Party               @relation(fields: [partyId], references: [id], onDelete: NoAction)
  allocations PaymentAllocation[]

  @@index([userId, type, date])
  @@index([partyId])
  @@map("payments")
}

// How much of one payment went to one bill.
model PaymentAllocation {
  id            String @id @default(cuid())
  paymentId     String @map("payment_id")
  transactionId String @map("transaction_id")
  amount        Float

  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // NoAction: a bill with payments can't be deleted (money would vanish).
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: NoAction)

  @@unique([paymentId, transactionId])
  @@index([transactionId])
  @@map("payment_allocations")
}
