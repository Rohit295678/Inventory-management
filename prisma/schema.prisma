// Inventory management schema.
// Purchases and sales share ONE table (Transaction.type) because they have
// identical shape — only the direction of goods differs.

// Prisma 7: datasource url lives in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  items        Item[]
  parties      Party[]
  transactions Transaction[]

  @@map("users")
}

// A kind of goods the user stocks, e.g. "Basmati Rice" (category "Rice").
model Item {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  category  String // "type of goods": Rice, Pulse, Oil, ...
  unit      String   @default("kg") // see UNITS in src/lib/pricing.ts
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines TransactionLine[]

  @@unique([userId, name])
  @@map("items")
}

// Someone we buy from (SUPPLIER), sell to (CUSTOMER), or both.
model Party {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  phone     String?
  address   String?
  kind      String // see PARTY_KINDS in src/lib/domain.ts
  createdAt DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, kind])
  @@map("parties")
}

// One purchase bill or one sale bill.
model Transaction {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String // PURCHASE | SALE
  partyId     String   @map("party_id")
  date        DateTime @db.Date
  note        String?
  // Denormalised sum of line totals, written once on create.
  totalAmount Float    @map("total_amount")
  createdAt   DateTime @default(now()) @map("created_at")

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  party Party             @relation(fields: [partyId], references: [id], onDelete: NoAction)
  lines TransactionLine[]

  @@index([userId, type, date])
  @@index([partyId])
  @@map("transactions")
}

model TransactionLine {
  id            String @id @default(cuid())
  transactionId String @map("transaction_id")
  itemId        String @map("item_id")
  quantity      Float // count in `unit`, e.g. 50 (packets)
  unit          String // snapshot of Item.unit at the time of the bill
  weightKg      Float  @map("weight_kg")
  ratePerKg     Float  @map("rate_per_kg")
  totalCost     Float  @map("total_cost")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  item        Item        @relation(fields: [itemId], references: [id], onDelete: NoAction)

  @@index([transactionId])
  @@index([itemId])
  @@map("transaction_lines")
}
