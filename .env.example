# Postgres connection strings.
# Local dev: the project-local Postgres started by `npm run db:start` (port 5433).
# Prod (e.g. Neon): DATABASE_URL = pooled URL, DIRECT_URL = unpooled URL.
DATABASE_URL="postgresql://postgres@localhost:5433/inv_mgmt"
DIRECT_URL="postgresql://postgres@localhost:5433/inv_mgmt"

# Local Postgres has no TLS. Leave unset (= TLS on) for hosted databases.
DATABASE_SSL="false"

# NextAuth. Generate with:  openssl rand -base64 32
# Also used to sign the mobile app's Bearer tokens.
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
