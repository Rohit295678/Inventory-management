# ---------------------------------------------------------------------------
# Database: pick ONE of the two blocks below.
# ---------------------------------------------------------------------------

# Option A: Neon (hosted). Use this app's OWN database, not MoneyMate's.
# In the Neon console > your project > Connect, select database "inv_mgmt":
#   - "Pooled connection" ON  -> DATABASE_URL (used by the running app)
#   - "Pooled connection" OFF -> DIRECT_URL   (used by `npm run db:push`)
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/inv_mgmt?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/inv_mgmt?sslmode=require"

# Option B: local Postgres on this laptop (port 5433, data in .pgdata/).
# `npm run dev` starts it automatically when these point at localhost.
DATABASE_URL="postgresql://postgres@localhost:5433/inv_mgmt"
DIRECT_URL="postgresql://postgres@localhost:5433/inv_mgmt"
# Local Postgres has no TLS. Delete this line when using Neon.
DATABASE_SSL="false"

# ---------------------------------------------------------------------------
# NextAuth. Generate with:  openssl rand -base64 32
# Also used to sign the mobile app's Bearer tokens.
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
